.head {
  padding: 28rpx 32rpx 8rpx;
}

.head-title {
  color: #17211b;
  font-size: 34rpx;
  font-weight: 700;
}

.head-note {
  display: block;
  margin-top: 8rpx;
  color: #6d7b8a;
  font-size: 26rpx;
}

.tip {
  padding: 24rpx 32rpx 0;
  color: #6d7b8a;
  font-size: 26rpx;
}

.match {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.pick {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  overflow: hidden;
  color: #17211b;
  font-size: 30rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f2f5f3;
  border-radius: 12rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vs {
  flex-shrink: 0;
  color: #8b97a3;
  font-size: 24rpx;
}

.pick--win {
  color: #ffffff;
  font-weight: 700;
  background: #d14343;
}
