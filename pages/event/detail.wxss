.detail-card {
  padding: 32rpx;
  background: #ffffff;
  border-radius: 0;
}

.detail-title {
  display: block;
  margin-top: 20rpx;
  color: #17211b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-line {
  display: block;
  margin-top: 16rpx;
  color: #526070;
  font-size: 28rpx;
  line-height: 1.4;
}

.detail-desc {
  display: block;
  margin-top: 28rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}

.submit-btn[disabled] {
  color: #ffffff;
  background: #b7c4bc;
}
