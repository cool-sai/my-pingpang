.my-rank {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #127a42 0%, #2fbe68 100%);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 122, 66, 0.22);
}

.my-rank-label {
  color: rgba(255, 255, 255, 0.88);
  font-size: 28rpx;
  line-height: 1.2;
}

.my-rank-info {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-width: 0;
}

.my-rank-num {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.my-rank-score {
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.2;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 40, 30, 0.06);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 32, 0.05);
}

.rank-item.top {
  background: linear-gradient(135deg, #fffaf0 0%, #fff4dc 100%);
  border-color: rgba(245, 176, 61, 0.22);
}

.rank-num {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  color: #647384;
  font-size: 28rpx;
  line-height: 1;
}

.rank-num.medal {
  font-size: 40rpx;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 50%;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  overflow: hidden;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-detail {
  display: block;
  margin-top: 6rpx;
  color: #7a8796;
  font-size: 24rpx;
  line-height: 1.3;
}

.rank-score-section {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.rank-score {
  color: #148f4c;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.rank-score-label {
  margin-left: 4rpx;
  color: #7a8796;
  font-size: 22rpx;
  line-height: 1;
}
