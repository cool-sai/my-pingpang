.home {
  min-height: 100vh;
  padding-bottom: calc(28rpx + 48px + env(safe-area-inset-bottom));
  background: #f2f5f3;
}

/* ===== Full-bleed immersive hero ===== */
.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #0c5a32;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

/* 指示点抬高，避开底部城市条叠层 */
.hero-swiper .wx-swiper-dots {
  bottom: 72rpx !important;
}

.hero-swiper .wx-swiper-dot {
  width: 10rpx !important;
  height: 10rpx !important;
  margin: 0 6rpx !important;
  border-radius: 999rpx !important;
  opacity: 1 !important;
}

.hero-swiper .wx-swiper-dot-active {
  width: 28rpx !important;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hero-slide--0 {
  background: linear-gradient(155deg, #0a4d2c 0%, #148f4c 48%, #3ecf7a 100%);
}

.hero-slide--1 {
  background: linear-gradient(155deg, #0d3d5c 0%, #147a8f 46%, #2fbea0 100%);
}

.hero-slide--2 {
  background: linear-gradient(155deg, #1a3d18 0%, #2f8f3a 50%, #a8d45a 110%);
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(80% 55% at 88% 12%, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 55%),
    radial-gradient(70% 50% at 8% 78%, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0) 60%);
  pointer-events: none;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2px);
}

.hero-orb--a {
  right: -60rpx;
  top: 18%;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 70%);
}

.hero-orb--b {
  left: -80rpx;
  bottom: 8%;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(0, 0, 0, 0.16) 0%, rgba(0, 0, 0, 0) 68%);
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 36rpx 96rpx;
  background:
    linear-gradient(180deg, rgba(6, 28, 16, 0.42) 0%, rgba(6, 28, 16, 0.08) 26%, rgba(6, 28, 16, 0) 42%),
    linear-gradient(180deg, rgba(6, 28, 16, 0) 38%, rgba(6, 28, 16, 0.55) 78%, rgba(6, 28, 16, 0.78) 100%);
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.hero-eyebrow-dot {
  width: 12rpx;
  height: 12rpx;
  background: #7dffb0;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(125, 255, 176, 0.22);
}

.hero-eyebrow-t {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  max-width: 92%;
  overflow: hidden;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 780;
  line-height: 1.22;
  letter-spacing: 0.5rpx;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.28);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-summary {
  display: block;
  margin-top: 12rpx;
  max-width: 90%;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 22rpx;
  height: 52rpx;
  padding: 0 22rpx 0 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  backdrop-filter: blur(10px);
}

.hero-cta-t {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 650;
}

.hero-cta-arrow {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
  margin-top: -2rpx;
}

.hero-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  height: 48rpx;
  background: linear-gradient(180deg, rgba(242, 245, 243, 0) 0%, #f2f5f3 100%);
  pointer-events: none;
}

/* ===== Floating city dock ===== */
.city-dock {
  position: relative;
  z-index: 30;
  margin-top: -56rpx;
  padding: 0 28rpx 0;
  transition: opacity 0.18s ease;
}

/* 上滑交接给顶栏城市时淡出，避免双城市闪一下 */
.city-dock--handoff {
  opacity: 0;
  pointer-events: none;
}

.city-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  box-shadow:
    0 18rpx 48rpx rgba(18, 40, 28, 0.12),
    0 2rpx 0 rgba(255, 255, 255, 0.8) inset;
  backdrop-filter: blur(18px);
}

.city-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding: 4rpx 4rpx 4rpx 0;
}

.city-trigger--pressed {
  opacity: 0.72;
}

.city-pin {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(160deg, #148f4c 0%, #2fbe68 100%);
  box-shadow: 0 8rpx 16rpx rgba(20, 143, 76, 0.22);
}

.city-pin-dot {
  width: 14rpx;
  height: 14rpx;
  background: #ffffff;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.city-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.city-trigger-k {
  color: #8b97a3;
  font-size: 20rpx;
  font-weight: 560;
  letter-spacing: 1rpx;
}

.city-trigger-v {
  overflow: hidden;
  color: #142018;
  font-size: 30rpx;
  font-weight: 740;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.city-trigger-caret {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin: 0 4rpx 0 0;
  border-right: 3rpx solid #9aa5b1;
  border-bottom: 3rpx solid #9aa5b1;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.city-create {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 72rpx;
  padding: 0 26rpx 0 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f7a40 0%, #1db864 55%, #3ad07a 120%);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 143, 76, 0.28);
}

.city-create--pressed {
  opacity: 0.86;
  transform: scale(0.98);
}

.city-create-plus {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
  margin-top: -2rpx;
}

.city-create-t {
  font-size: 26rpx;
  font-weight: 720;
  letter-spacing: 1rpx;
}

/* ===== Match section ===== */
.section {
  margin-top: 8rpx;
  padding: 8rpx 0 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 32rpx 8rpx;
}

.section-titles {
  min-width: 0;
}

.section-title {
  display: block;
  color: #142018;
  font-size: 34rpx;
  font-weight: 780;
  line-height: 1.25;
  letter-spacing: 0.5rpx;
}

.section-sub {
  display: block;
  margin-top: 6rpx;
  color: #7a8796;
  font-size: 22rpx;
  line-height: 1.3;
}

.section-count {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  color: #148f4c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  background: rgba(20, 143, 76, 0.1);
  border-radius: 999rpx;
}

.event-list {
  padding-top: 12rpx;
}

.empty {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 28rpx 0;
  padding: 64rpx 32rpx 48rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(18, 40, 28, 0.05);
}

.empty-ring {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid rgba(20, 143, 76, 0.16);
  border-top-color: #1db864;
  border-radius: 50%;
}

.empty-title {
  color: #17211b;
  font-size: 30rpx;
  font-weight: 720;
  text-align: center;
}

.empty-sub {
  margin-top: 10rpx;
  color: #8b97a3;
  font-size: 24rpx;
  text-align: center;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.empty-btn {
  height: 68rpx;
  padding: 0 28rpx;
  color: #243028;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 68rpx;
  background: #eef2ef;
  border-radius: 999rpx;
}

.empty-btn--primary {
  color: #ffffff;
  background: linear-gradient(135deg, #0f7a40 0%, #1db864 100%);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(17, 24, 20, 0.45);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.sheet-mask--on {
  opacity: 1;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  padding: 12rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  background: #f7f8f7;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.26s ease;
}

.sheet--on {
  transform: translateY(0);
}

.sheet-grab {
  width: 64rpx;
  height: 8rpx;
  margin: 8rpx auto 20rpx;
  background: #d5dde3;
  border-radius: 999rpx;
}

.sheet-title {
  display: block;
  padding: 0 32rpx;
  color: #17211b;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-caption {
  display: block;
  margin-top: 24rpx;
  padding: 0 32rpx;
  color: #8b97a3;
  font-size: 24rpx;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 32rpx 8rpx;
}

.hot-item {
  width: calc((100% - 48rpx) / 4);
  height: 72rpx;
  color: #243028;
  font-size: 26rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 14rpx;
}

.hot-item--on {
  color: #148f4c;
  font-weight: 700;
  background: rgba(20, 143, 76, 0.12);
}

.sheet-list {
  margin: 20rpx 24rpx 0;
  overflow: hidden;
  background: #ffffff;
  border-radius: 20rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 96rpx;
  padding: 0 28rpx;
}

.sheet-row + .sheet-row,
picker + .sheet-row {
  border-top: 1rpx solid rgba(22, 40, 30, 0.06);
}

.sheet-row-t {
  color: #17211b;
  font-size: 30rpx;
}

.sheet-row-a {
  color: #8b97a3;
  font-size: 24rpx;
}

.sheet-cancel {
  height: 96rpx;
  margin: 16rpx 24rpx 0;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 20rpx;
}
