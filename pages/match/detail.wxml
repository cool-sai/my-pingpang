<view class="container {{isLoading && !match ? 'is-skeleton' : ''}}" wx:if="{{match || isLoading}}">
  <view class="detail-card">
    <text class="status-pill {{match.status === 'pending' ? 'status-pill--warning' : 'status-pill--success'}}">{{isLoading && !match ? '' : match.statusText}}</text>
    <text class="detail-title">{{isLoading && !match ? '' : ((match.player1.nickname || '选手') + ' ' + (match.player1.score || match.player1Score || 0) + ' : ' + (match.player2.score || match.player2Score || 0) + ' ' + (match.player2.nickname || '选手'))}}</text>
    <text class="detail-line">{{match.date || match.createTime || ''}}</text>
    <text class="detail-line">{{isLoading && !match ? '' : (match.location || '地点未填')}}</text>
  </view>
</view>
<view class="container" wx:elif="{{!isLoading}}">
  <view class="empty-tip">没有找到这场对阵</view>
</view>
<page-loading wx:if="{{isLoading}}" />
