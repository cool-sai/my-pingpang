.container.has-fab {
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.fab {
  bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.match-list {
  display: flex;
  flex-direction: column;
}

.match-item {
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: none;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
  border-radius: 0;
  box-shadow: none;
}

.match-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 44rpx;
  margin-bottom: 20rpx;
}

.match-date {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #617180;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.match-players {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.player {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.player-avatar {
  width: 84rpx;
  height: 84rpx;
  border: 4rpx solid #edf4ef;
  border-radius: 50%;
}

.player-name {
  width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #23303d;
  font-size: 26rpx;
  line-height: 1.3;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.player-score {
  min-width: 48rpx;
  margin-top: 8rpx;
  color: #23303d;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  text-align: center;
}

.player-score.winner {
  color: #148f4c;
}

.vs-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
}

.vs {
  color: #9aa7b4;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.match-info {
  display: flex;
  align-items: center;
  min-height: 40rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2ef;
}

.match-location {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #778595;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}
