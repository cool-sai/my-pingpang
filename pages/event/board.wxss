.tabs {
  height: 88rpx;
  white-space: nowrap;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
  box-sizing: border-box;
}

.tab {
  position: relative;
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  color: #627283;
  font-size: 28rpx;
  line-height: 88rpx;
  background: transparent;
  border-radius: 0;
  vertical-align: top;
}

.tab--on {
  color: #148f4c;
  font-weight: 700;
  background: transparent;
  box-shadow: inset 0 -4rpx 0 #148f4c;
}

.tab-me {
  height: 32rpx;
  padding: 0 10rpx;
  color: #148f4c;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  background: #e8f8ee;
  border-radius: 8rpx;
}

.note-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx 0;
  background: #ffffff;
}

.note {
  flex: 1;
  min-width: 0;
  color: #6d7b8a;
  font-size: 26rpx;
}

.note-edit {
  flex-shrink: 0;
  color: #148f4c;
  font-size: 26rpx;
}


.standings {
  margin-top: 16rpx;
  background: #ffffff;
}

.standings-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.standings-row--head {
  min-height: 56rpx;
  color: #6d7b8a;
  font-size: 24rpx;
}

.standings-row--mine {
  background-color: rgba(20, 143, 76, 0.06);
}

.standings-row--mine .st-name {
  color: #148f4c;
  font-weight: 700;
}

.st-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 26rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.st-num {
  width: 72rpx;
  flex-shrink: 0;
  color: #17211b;
  font-size: 26rpx;
  text-align: center;
}

.standings-row--head .st-name,
.standings-row--head .st-num {
  color: #6d7b8a;
  font-weight: 400;
}

.table {
  margin-top: 16rpx;
  background: #ffffff;
}

.table-row {
  display: flex;
}

.cell {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
  border-right: 1rpx solid rgba(22, 40, 30, 0.06);
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.cell--name {
  flex: none;
  width: 168rpx;
  padding: 0 12rpx;
  overflow: hidden;
  color: #17211b;
  font-size: 24rpx;
  text-align: left;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.table-row--mine .cell:not(.cell--self) {
  background-color: rgba(20, 143, 76, 0.06);
}

.cell--col-mine:not(.cell--self),
.cell--head-mine {
  background-color: rgba(20, 143, 76, 0.06);
}

.cell--head-mine {
  color: #148f4c;
  font-weight: 700;
}

.cell--mine {
  padding-left: 18rpx;
  color: #148f4c;
  font-weight: 700;
  box-shadow: inset 6rpx 0 0 #148f4c;
}

.cell--self {
  background-color: #f4f6f5;
  background-image: linear-gradient(
    135deg,
    transparent calc(50% - 0.5px),
    rgba(22, 40, 30, 0.14) calc(50% - 0.5px),
    rgba(22, 40, 30, 0.14) calc(50% + 0.5px),
    transparent calc(50% + 0.5px)
  );
}

.has-score {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  height: 88rpx;
  margin: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 88rpx;
  background: #148f4c;
  border-radius: 12rpx;
}

.cell--win {
  color: #d14343;
  font-size: 32rpx;
  font-weight: 700;
}

.cell--lose {
  color: #8b97a3;
  font-size: 32rpx;
  font-weight: 700;
}
