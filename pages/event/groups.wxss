.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  color: #17211b;
  font-size: 32rpx;
  font-weight: 700;
}

.row-meta,
.row-note {
  display: block;
  margin-top: 8rpx;
  color: #6d7b8a;
  font-size: 26rpx;
}

.row-go {
  flex-shrink: 0;
  color: #8b97a3;
  font-size: 26rpx;
}

.row-edit {
  flex-shrink: 0;
  color: #148f4c;
  font-size: 26rpx;
}
