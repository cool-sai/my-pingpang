<view class="container">
  <!-- 用户信息区域 -->
  <view class="profile-card {{userInfo ? 'profile-card--authed' : ''}}">
    <view class="profile-content" wx:if="{{userInfo}}">
      <image class="avatar" src="{{userInfo.avatar || placeholder}}" />
      <text class="nickname">{{userInfo.nickname}}</text>
      <text class="score">积分 {{userInfo.score || 0}} · 信用分 {{userInfo.creditScore || 80}}</text>
      <button class="login-btn" hover-class="none" bindtap="onEditProfile">{{userInfo.profileReady ? '修改资料' : '设置昵称'}}</button>
    </view>
    <view class="profile-content" wx:else>
      <image class="avatar" src="{{placeholder}}" />
      <text class="nickname">点击下方按钮登录</text>
      <button class="login-btn" hover-class="none" bindtap="onLogin">微信登录</button>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-section" wx:if="{{userInfo}}">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalMatches}}</text>
      <text class="stat-label">总比赛</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.winRate}}%</text>
      <text class="stat-label">胜率</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.score}}</text>
      <text class="stat-label">积分</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="id" data-id="{{item.id}}" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="goToMenu">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
      <view class="menu-arrow"></view>
    </view>
  </view>

  <button class="logout-btn" wx:if="{{userInfo}}" hover-class="none" bindtap="onLogout">退出登录</button>
</view>
