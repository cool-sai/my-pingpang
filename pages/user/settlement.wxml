<wxs src="../../utils/skeleton.wxs" module="sk" />
<page-loading wx:if="{{isLoading && !ready}}" />
<view class="container {{isLoading && !ready ? 'is-skeleton' : ''}}" wx:if="{{!denied}}">
  <view class="filter-tabs">
    <view class="tab {{tab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="onTab">
      <text>待结算{{ready && pendingCount ? ' (' + pendingCount + ')' : ''}}</text>
    </view>
    <view class="tab {{tab === 'settled' ? 'active' : ''}}" data-tab="settled" bindtap="onTab">
      <text>已结算{{ready && settledCount ? ' (' + settledCount + ')' : ''}}</text>
    </view>
  </view>

  <view class="section sys-card" wx:if="{{ready}}">
    <view class="sys-row sys-row--warn" wx:if="{{journal}}">
      <view class="sys-info">
        <text class="sys-title">有未完成的写入日志</text>
        <text class="sys-sub">比赛 {{journal.eventId}} · {{journal.matchesCount}} 局 / {{journal.usersCount}} 人</text>
      </view>
      <button class="act-btn act-btn--warn" hover-class="none" loading="{{acting === 'replay'}}" disabled="{{!!acting}}" bindtap="onReplay">补完写入</button>
    </view>
    <view class="sys-row sys-row--warn" wx:if="{{lock && lock.locked}}">
      <view class="sys-info">
        <text class="sys-title">全局结算锁占用中{{lock.expired ? '（已超时）' : ''}}</text>
        <text class="sys-sub">关联 {{lock.eventId || '未知'}} · {{lock.lockedText}}</text>
      </view>
      <button class="act-btn act-btn--danger" hover-class="none" loading="{{acting === 'unlock'}}" disabled="{{!!acting}}" bindtap="onUnlock">强制解锁</button>
    </view>
    <view class="sys-ok" wx:if="{{!journal && (!lock || !lock.locked)}}">结算锁空闲 · 无异常日志</view>
  </view>

  <block wx:if="{{isLoading && !ready}}">
    <view class="event-list">
      <view class="event-row" wx:for="{{sk.pad([], true, 4)}}" wx:key="_id">
        <view class="row-main">
          <view class="row-top">
            <text class="detail-title">{{item.name}}</text>
            <text class="status-pill status-pill--muted">{{item.statusText}}</text>
          </view>
          <text class="detail-line">{{item.location}}</text>
        </view>
      </view>
    </view>
  </block>
  <block wx:elif="{{visible.length}}">
    <view class="event-list">
      <view class="event-row" wx:for="{{visible}}" wx:key="_id" data-id="{{item._id}}" bindtap="goToDetail">
        <view class="row-main">
          <view class="row-top">
            <text class="event-name">{{item.name}}</text>
            <text class="status-pill {{item.badgeClass}}">{{item.badgeText}}</text>
          </view>
          <text class="event-meta">{{item.metaText}}</text>
        </view>
        <button
          wx:if="{{!item.settled}}"
          class="act-btn"
          hover-class="none"
          loading="{{acting === item._id}}"
          disabled="{{!!acting}}"
          data-id="{{item._id}}"
          catchtap="onSettle"
        >结算</button>
      </view>
    </view>
  </block>
  <view class="empty-tip" wx:else>
    <text>{{tab === 'pending' ? '没有待结算的比赛' : '还没有已结算的比赛'}}</text>
  </view>
</view>
<view class="container" wx:else>
  <view class="empty-tip">无权限访问</view>
</view>
