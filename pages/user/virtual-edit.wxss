.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 36rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  line-height: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
}

.avatar,
.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #e7eeea;
}

.avatar-tip {
  margin-top: 16rpx;
  color: #7a8796;
  font-size: 24rpx;
  line-height: 1.4;
}

.avatar-clear {
  margin-top: 8rpx;
  color: #148f4c;
  font-size: 26rpx;
  line-height: 1.4;
}

.field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  background: #ffffff;
}

.field-label {
  flex-shrink: 0;
  width: 112rpx;
  color: #526070;
  font-size: 28rpx;
  line-height: 1.4;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  color: #17211b;
  font-size: 30rpx;
  line-height: 104rpx;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}

.submit-btn[disabled] {
  opacity: 0.7;
}
