.container {
  padding: 24rpx 0 calc(32rpx + env(safe-area-inset-bottom));
}

.profile-card {
  margin: 0 24rpx 24rpx;
  background: linear-gradient(160deg, #127a42 0%, #2fbe68 100%);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 122, 66, 0.22);
}

.profile-card--authed {
  margin-bottom: 0;
  padding-bottom: 56rpx;
}

.profile-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(19, 59, 37, 0.16);
}

.nickname {
  max-width: 100%;
  margin-top: 20rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.score {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 1.3;
}

.login-btn {
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 48rpx;
  background: #ffffff;
  color: #148f4c;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 36rpx;
}

.stats-section {
  display: flex;
  align-items: center;
  margin: -36rpx 48rpx 24rpx;
  padding: 28rpx 8rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 40, 30, 0.06);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 32, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  min-width: 0;
}

.stat-value {
  color: #148f4c;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  color: #7a8796;
  font-size: 24rpx;
  line-height: 1.2;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: #e7eeea;
}

.menu-section {
  margin: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 40, 30, 0.06);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 32, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eef2ef;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  font-size: 36rpx;
  line-height: 1;
}

.menu-title {
  flex: 1;
  min-width: 0;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 1.3;
}

.menu-arrow {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-top: 4rpx solid #c5ced6;
  border-right: 4rpx solid #c5ced6;
  transform: rotate(45deg);
}
