<view class="home">
  <swiper
    class="banner"
    indicator-dots
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#ffffff"
    autoplay="{{news.length > 1}}"
    circular="{{news.length > 1}}"
    interval="4000"
    duration="500"
  >
    <swiper-item wx:for="{{news}}" wx:key="id">
      <view class="banner-slide" data-id="{{item.id}}" bindtap="goToNews">
        <image wx:if="{{item.cover}}" class="banner-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="banner-mask">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-summary">{{item.summary}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="list-head">
    <view class="region-side">
      <picker mode="region" level="city" bindchange="setRegion" value="{{region}}">
        <view class="region-pick">{{regionText}}</view>
      </picker>
      <text wx:if="{{province}}" class="region-clear" bindtap="clearRegion">全部</text>
    </view>
    <text class="list-action" bindtap="goToCreate">创建</text>
  </view>

  <view class="list-loading" wx:if="{{isLoading}}">
    <view class="list-spinner"></view>
  </view>
  <event-card wx:for="{{events}}" wx:key="_id" event="{{item}}" bind:select="goToEventDetail" />
  <view class="empty-tip" wx:if="{{!isLoading && events.length === 0}}">{{province ? '这个城市还没有比赛' : '附近还没有比赛'}}</view>
</view>
