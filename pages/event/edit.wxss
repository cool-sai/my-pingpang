.field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.field--block {
  display: block;
  padding: 28rpx 32rpx 32rpx;
}

.field-label {
  flex-shrink: 0;
  width: 112rpx;
  color: #526070;
  font-size: 28rpx;
  line-height: 1.4;
}

.field-input,
.field-picker {
  flex: 1;
  min-width: 0;
}

.field-picker {
  display: block;
}

.field-input,
.field-value {
  height: 104rpx;
  color: #17211b;
  font-size: 30rpx;
  line-height: 104rpx;
}

.field-value--pick {
  position: relative;
  padding-right: 28rpx;
}

.field-value--pick::after {
  content: '';
  position: absolute;
  right: 4rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-top: -12rpx;
  border-right: 3rpx solid #b0b8c0;
  border-bottom: 3rpx solid #b0b8c0;
  transform: rotate(45deg);
}

.is-placeholder {
  color: #a3adb8;
}

.field-area {
  width: 100%;
  height: 200rpx;
  margin-top: 16rpx;
  color: #17211b;
  font-size: 30rpx;
  line-height: 1.5;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}

.submit-btn[disabled] {
  color: #ffffff;
  background: #b7c4bc;
}
