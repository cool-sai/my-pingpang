.my-rank {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #167c49 0%, #32c26b 100%);
  border-radius: 28rpx;
  box-shadow: 0 20rpx 40rpx rgba(22, 124, 73, 0.22);
}

.my-rank-label {
  color: rgba(255, 255, 255, 0.86);
  font-size: 28rpx;
}

.my-rank-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.my-rank-num {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.my-rank-score {
  color: rgba(255, 255, 255, 0.86);
  font-size: 28rpx;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(25, 45, 37, 0.06);
}

.rank-item.top {
  background: linear-gradient(135deg, #fff8e7 0%, #fff3d6 100%);
  border-color: rgba(245, 176, 61, 0.18);
}

.rank-num {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  color: #647384;
  margin-right: 20rpx;
}

.rank-num.medal {
  font-size: 36rpx;
}

.rank-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 700;
  display: block;
}

.rank-detail {
  font-size: 24rpx;
  color: #7a8796;
}

.rank-score-section {
  display: flex;
  align-items: baseline;
}

.rank-score {
  font-size: 36rpx;
  font-weight: 700;
  color: #198f50;
}

.rank-score-label {
  font-size: 24rpx;
  color: #7a8796;
  margin-left: 4rpx;
}
