<view class="container has-submit" wx:if="{{event}}">
  <view class="hero">
    <text class="hero-status hero-status--{{event.status}}">{{event.statusText}}</text>
    <text class="hero-title">{{event.name}}</text>
    <text class="hero-who">发起人 {{event.creatorName || '球友'}}</text>
  </view>

  <view class="info">
    <view class="info-row">
      <text class="info-k">时间</text>
      <text class="info-v">{{event.startTime || '待定'}}</text>
    </view>
    <view class="info-row">
      <text class="info-k">地点</text>
      <text class="info-v">{{event.location || '待定'}}</text>
    </view>
    <view class="info-row">
      <text class="info-k">赛制</text>
      <text class="info-v">{{event.format || '未设置'}}</text>
    </view>
    <view class="info-row">
      <text class="info-k">人数</text>
      <text class="info-v">已报名 {{event.signupCount || 0}} 人{{event.maxPlayers > 0 ? ' / 上限 ' + event.maxPlayers + ' 人' : ' / 不限'}}</text>
    </view>
  </view>

  <view class="desc">
    <text class="desc-k">说明</text>
    <text class="desc-v">{{event.description || '暂无说明'}}</text>
  </view>

  <view class="owner-bar" wx:if="{{isOwner}}">
    <button class="owner-btn" hover-class="none" bindtap="goToEdit">编辑</button>
    <button class="owner-btn owner-btn--danger" hover-class="none" loading="{{deleting}}" disabled="{{deleting}}" bindtap="onDelete">删除</button>
  </view>
</view>
<view class="container" wx:elif="{{!isLoading}}">
  <view class="empty-tip">没有找到这场比赛</view>
</view>

<view class="submit-bar" wx:if="{{event}}">
  <button class="submit-btn" hover-class="none" disabled="{{signed || event.status === 'finished'}}" bindtap="onSignup">
    {{signed ? '已报名' : event.status === 'finished' ? '报名已结束' : '报名'}}
  </button>
</view>
