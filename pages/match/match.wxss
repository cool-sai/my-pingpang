.container {
  padding-bottom: 160rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-item {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(25, 45, 37, 0.06);
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.match-date {
  font-size: 26rpx;
  color: #617180;
}

.match-players {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.player {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
  border: 4rpx solid #edf4ef;
}

.player-name {
  font-size: 26rpx;
  color: #23303d;
  margin-bottom: 8rpx;
}

.player-score {
  font-size: 36rpx;
  font-weight: 700;
  color: #23303d;
}

.player-score.winner {
  color: #198f50;
}

.vs {
  font-size: 28rpx;
  color: #93a0ad;
  font-weight: 700;
}

.match-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1ee;
}

.match-location {
  font-size: 24rpx;
  color: #778595;
}

.empty-subtip {
  margin-top: 4rpx;
}
