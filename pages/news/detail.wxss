.article {
  min-height: 100%;
  background: #ffffff;
}

.cover {
  width: 100%;
  height: 420rpx;
}

.body {
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

.title {
  display: block;
  color: #17211b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.date {
  display: block;
  margin-top: 16rpx;
  color: #8a97a3;
  font-size: 24rpx;
  line-height: 1.3;
}

.paragraph {
  display: block;
  margin-top: 28rpx;
  color: #2c3844;
  font-size: 30rpx;
  line-height: 1.7;
}
