<view class="container">
  <!-- 状态筛选 -->
  <view class="filter-tabs">
    <view class="tab {{status === 'all' ? 'active' : ''}}" data-status="all" bindtap="switchStatus">全部</view>
    <view class="tab {{status === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="switchStatus">待确认</view>
    <view class="tab {{status === 'completed' ? 'active' : ''}}" data-status="completed" bindtap="switchStatus">已结束</view>
  </view>

  <!-- 比赛列表 -->
  <view class="match-list">
    <view class="match-item" wx:for="{{matches}}" wx:key="_id" data-id="{{item._id}}" bindtap="goToMatchDetail">
      <view class="match-header">
        <text class="match-date">{{item.date}}</text>
        <text class="match-status status-pill {{item.status === 'pending' ? 'status-pill--warning' : 'status-pill--success'}}">{{item.statusText}}</text>
      </view>
      <view class="match-players">
        <view class="player">
          <image class="player-avatar" src="{{item.player1.avatar || '/images/default_avatar.png'}}" />
          <text class="player-name">{{item.player1.nickname}}</text>
          <text class="player-score {{item.winner === 'player1' ? 'winner' : ''}}">{{item.player1Score}}</text>
        </view>
        <text class="vs">VS</text>
        <view class="player">
          <image class="player-avatar" src="{{item.player2.avatar || '/images/default_avatar.png'}}" />
          <text class="player-name">{{item.player2.nickname}}</text>
          <text class="player-score {{item.winner === 'player2' ? 'winner' : ''}}">{{item.player2Score}}</text>
        </view>
      </view>
      <view class="match-info">
        <text class="match-location">{{item.location || '未设置地点'}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{matches.length === 0 && !isLoading}}">
      <text>暂无比赛记录</text>
      <text class="empty-subtip">点击下方按钮发起比赛</text>
    </view>
  </view>

  <!-- 发起比赛按钮 -->
  <view class="fab" bindtap="goToCreateMatch">+</view>
</view>
