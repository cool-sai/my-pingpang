.tabs {
  height: 96rpx;
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
  background: #ffffff;
  box-sizing: border-box;
}

.tab {
  position: relative;
  display: inline-block;
  margin-right: 20rpx;
  padding: 12rpx 36rpx 12rpx 20rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  background: #f2f5f3;
  border-radius: 999rpx;
}

.tab-dot {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #d14343;
  border-radius: 50%;
}

.tab--on {
  color: #148f4c;
  font-weight: 700;
  background: rgba(20, 143, 76, 0.12);
}

.note-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx 0;
  background: #ffffff;
}

.note {
  flex: 1;
  min-width: 0;
  color: #6d7b8a;
  font-size: 26rpx;
}

.note-edit {
  flex-shrink: 0;
  color: #148f4c;
  font-size: 26rpx;
}

.table {
  margin-top: 16rpx;
  background: #ffffff;
}

.table-row {
  display: flex;
}

.cell {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
  border-right: 1rpx solid rgba(22, 40, 30, 0.06);
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.cell--name {
  flex: none;
  width: 168rpx;
  padding: 0 12rpx;
  overflow: hidden;
  color: #17211b;
  font-size: 24rpx;
  text-align: left;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cell--mine {
  color: #148f4c;
  font-weight: 700;
  background: rgba(20, 143, 76, 0.12);
}

.cell--self {
  background-image: linear-gradient(to bottom left, transparent 49%, #b7c1ca 49%, #b7c1ca 51%, transparent 51%);
}

.has-score {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  height: 88rpx;
  margin: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 88rpx;
  background: #148f4c;
  border-radius: 12rpx;
}

.cell--win {
  color: #d14343;
  font-size: 32rpx;
  font-weight: 700;
}

.cell--lose {
  color: #8b97a3;
  font-size: 32rpx;
  font-weight: 700;
}
