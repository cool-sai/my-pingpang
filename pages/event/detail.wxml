<view class="container has-submit {{isLoading && !event ? 'is-skeleton' : ''}}" wx:if="{{event || isLoading}}">
  <image wx:if="{{event.coverUrl || event.cover}}" class="cover" src="{{event.coverUrl || event.cover}}" mode="aspectFill" />
  <view wx:elif="{{isLoading}}" class="cover"></view>
  <view class="hero">
    <view class="hero-top">
      <text class="hero-title">{{event.name}}</text>
      <button class="share-btn-title" hover-class="share-btn-title--hover" open-type="share">
        <view class="share-icon">
          <view class="share-dot share-dot--c"></view>
          <view class="share-dot share-dot--t"></view>
          <view class="share-dot share-dot--b"></view>
          <view class="share-line share-line--t"></view>
          <view class="share-line share-line--b"></view>
        </view>
        <text class="share-btn-text">分享</text>
      </button>
    </view>
    <view class="tags">
      <text class="tag tag--{{event.status}}">{{event.statusText}}</text>
      <text class="tag tag--format" wx:if="{{event.format || isLoading}}">{{event.format}}</text>
    </view>
  </view>

  <view class="sheet">
    <view class="line">
      <text class="line-k">时间</text>
      <text class="line-v">{{event.startTime || (isLoading ? '' : '待定')}}</text>
    </view>
    <view class="line" bindtap="openLocation">
      <text class="line-k">地点</text>
      <text class="line-v {{event.hasMap ? 'line-v--link' : ''}}">{{event.location || (isLoading ? '' : '待定')}}</text>
    </view>
    <view class="line">
      <text class="line-k">人数</text>
      <text class="line-v">{{isLoading && !event ? '' : ((event.signupCount || 0) + '/' + (event.maxPlayers > 0 ? event.maxPlayers : '不限'))}}</text>
      <text class="roster-link" bindtap="goToRoster">参赛名单</text>
    </view>
    <view class="line" wx:if="{{event.started}}">
      <text class="line-k">赛程</text>
      <text wx:if="{{signed}}" class="roster-link" bindtap="goToScore">录入成绩</text>
      <text class="roster-link" bindtap="goToGroups">查看分组</text>
    </view>
  </view>

  <view class="block">
    <text class="block-k">说明</text>
    <text class="block-v">{{event.description || (isLoading ? '' : '暂无说明')}}</text>
  </view>
</view>
<view class="container" wx:elif="{{!isLoading}}">
  <view class="empty-tip">没有找到这场比赛</view>
</view>
<page-loading wx:if="{{isLoading}}" />

<view class="submit-bar detail-bar {{isLoading && !event ? 'is-skeleton' : ''}}" wx:if="{{event || isLoading}}">
  <text wx:if="{{isOwner}}" class="manage-text" bindtap="openManage">管理</text>
  <button
    class="submit-btn {{signed ? 'submit-btn--ghost' : ''}}"
    hover-class="none"
    loading="{{signing}}"
    disabled="{{signing || event.started || (!signed && (event.status === 'finished' || full))}}"
    bindtap="onSignupTap"
  >{{event.started ? (signed ? '已报名' : '已开始') : signed ? '取消报名' : event.status === 'finished' ? '已结束' : full ? '已满' : '报名'}}</button>
</view>

<view class="manage-mask {{showManage ? 'manage-mask--on' : ''}}" wx:if="{{isOwner}}" catchtouchmove="stopMove" bindtap="closeManage"></view>
<view class="manage-sheet {{showManage ? 'manage-sheet--on' : ''}}" wx:if="{{isOwner}}" catchtouchmove="stopMove">
  <view wx:if="{{event && !event.started}}" class="manage-action" bindtap="addVirtual">加虚拟球友</view>
  <view wx:if="{{event && !event.started}}" class="manage-action" bindtap="startEvent">开启比赛</view>
  <view wx:if="{{event && event.started && event.status !== 'finished' && !event.settled}}" class="manage-action" bindtap="finishEvent">结束比赛</view>
  <view class="manage-action" bindtap="goToEdit">编辑</view>
  <view wx:if="{{event && event.status !== 'finished' && !event.settled}}" class="manage-action manage-action--danger" bindtap="onDelete">删除</view>
  <view class="manage-gap"></view>
  <view class="manage-action" bindtap="closeManage">取消</view>
</view>
