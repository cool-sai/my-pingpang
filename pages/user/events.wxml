<view class="container">
  <view class="event-list" wx:if="{{!isLoading || events.length > 0}}">
    <event-card wx:for="{{events}}" wx:key="_id" event="{{item}}" bind:select="goToEventDetail" />
  </view>

  <view class="empty-tip" wx:if="{{isLoading && events.length === 0}}">
    <text>加载中</text>
  </view>

  <view class="empty-tip" wx:if="{{!isLoading && events.length === 0}}">
    <text>{{emptyText}}</text>
  </view>
</view>
