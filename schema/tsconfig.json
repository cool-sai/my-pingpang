{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../cloudfunctions/common/models.ts",
    "../cloudfunctions/common/types.ts"
  ],
  "exclude": [
    ".serve"
  ]
}
