page {
  min-height: 100%;
  background-color: #f2f5f3;
  background-image: radial-gradient(120% 42% at 50% -10%, #e5f6eb 0%, rgba(242, 245, 243, 0) 68%);
  color: #1c2430;
  font-size: 28rpx;
  line-height: 1.4;
}

view,
text,
button,
input,
image {
  box-sizing: border-box;
}

image {
  display: block;
}

button {
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: inherit;
  background: transparent;
  color: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.container {
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
}

.container.has-tab {
  padding-bottom: calc(28rpx + 48px + env(safe-area-inset-bottom));
}

.container.has-fab {
  padding-bottom: calc(156rpx + 48px + env(safe-area-inset-bottom));
}

.container.has-submit {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 0;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: none;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
  border-radius: 0;
  box-shadow: none;
}

.section:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  min-height: 44rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #18212f;
}

.section-more {
  height: 44rpx;
  font-size: 24rpx;
  line-height: 44rpx;
  color: #6b7785;
}

.filter-tabs {
  display: flex;
  align-items: center;
  margin-bottom: 0;
  padding: 0;
  background: #ffffff;
  border: none;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
  border-radius: 0;
  box-shadow: none;
}

.tab {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 8rpx;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
  color: #627283;
}

.tab.active {
  background: transparent;
  color: #148f4c;
  font-weight: 700;
  box-shadow: inset 0 -4rpx 0 #148f4c;
}

.status-pill {
  display: inline-block;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-pill--success {
  background: #e8f8ee;
  color: #148f4c;
}

.status-pill--info {
  background: #eaf3ff;
  color: #2c6de0;
}

.status-pill--warning {
  background: #fff4e8;
  color: #e0861a;
}

.status-pill--muted {
  background: #eef1f4;
  color: #778391;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 72rpx 32rpx;
  text-align: center;
  color: #7a8794;
  font-size: 28rpx;
  line-height: 1.4;
}

.section .empty-tip {
  padding: 36rpx 16rpx;
}

.empty-subtip {
  font-size: 24rpx;
  line-height: 1.4;
  color: #9aa6b2;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(24rpx + 48px + env(safe-area-inset-bottom));
  z-index: 20;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  box-shadow: 0 16rpx 32rpx rgba(20, 143, 76, 0.28);
}

.fab::before,
.fab::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: #ffffff;
  border-radius: 4rpx;
}

.fab::before {
  width: 36rpx;
  height: 6rpx;
  margin-left: -18rpx;
  margin-top: -3rpx;
}

.fab::after {
  width: 6rpx;
  height: 36rpx;
  margin-left: -3rpx;
  margin-top: -18rpx;
}

.field-placeholder {
  color: #a3adb8;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(242, 245, 243, 0.96);
}
