<view class="card card--{{event.status}}" hover-class="card--pressed" bindtap="onTap">
  <view class="card-head">
    <text class="card-name">{{event.name}}</text>
    <text class="card-status card-status--{{event.status}}">{{event.statusText}}</text>
  </view>
  <view class="card-line">
    <text class="card-k">时间</text>
    <text class="card-v">{{event.startTime || '待定'}}</text>
  </view>
  <view class="card-line">
    <text class="card-k">地点</text>
    <text class="card-v">{{event.location || '待定'}}</text>
  </view>
  <view class="card-line">
    <text class="card-k">赛制</text>
    <text class="card-v">{{event.format || '未设置'}}</text>
  </view>
  <view class="card-foot">
    <text class="card-who">{{event.creatorName || '球友'}}</text>
    <text class="card-count">已报名 {{event.signupCount || 0}}{{event.maxPlayers > 0 ? '/' + event.maxPlayers : ' 人'}}</text>
  </view>
</view>
