.event-list {
  display: flex;
  flex-direction: column;
}

.event-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: none;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
  border-radius: 0;
  box-shadow: none;
}

.event-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #fff6d8 0%, #ffefba 100%);
  border-radius: 0;
}

.event-icon {
  font-size: 52rpx;
  line-height: 1;
}

.event-content {
  flex: 1;
  min-width: 0;
}

.event-name {
  display: block;
  overflow: hidden;
  margin-bottom: 10rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.event-time,
.event-location {
  display: block;
  overflow: hidden;
  color: #7a8796;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 44rpx;
  margin-top: 12rpx;
}

.event-signup {
  margin-left: auto;
  overflow: hidden;
  color: #7a8796;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
  text-overflow: ellipsis;
}
