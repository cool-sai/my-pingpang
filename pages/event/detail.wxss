.hero,
.info,
.desc,
.owner-bar {
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.hero {
  padding: 36rpx 32rpx 32rpx;
}

.hero-status {
  display: block;
  color: #148f4c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-status--upcoming {
  color: #2c6de0;
}

.hero-status--finished {
  color: #8b97a3;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  color: #17211b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-who {
  display: block;
  margin-top: 12rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 1.4;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.info-row:last-child {
  border-bottom: none;
}

.info-k {
  flex-shrink: 0;
  width: 72rpx;
  color: #8b97a3;
  font-size: 28rpx;
  line-height: 1.4;
}

.info-v {
  flex: 1;
  min-width: 0;
  color: #17211b;
  font-size: 28rpx;
  line-height: 1.4;
}

.info-place,
.info-address,
.info-map {
  display: block;
}

.info-address {
  margin-top: 6rpx;
  color: #6d7b8a;
  font-size: 24rpx;
}

.info-map {
  margin-top: 8rpx;
  color: #148f4c;
  font-size: 24rpx;
}

.desc {
  padding: 28rpx 32rpx 32rpx;
}

.desc-k {
  display: block;
  color: #8b97a3;
  font-size: 28rpx;
  line-height: 1.4;
}

.desc-v {
  display: block;
  margin-top: 12rpx;
  color: #243028;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.owner-bar {
  display: flex;
}

.owner-btn {
  flex: 1;
  height: 96rpx;
  color: #148f4c;
  font-size: 30rpx;
  font-weight: 600;
}

.owner-btn + .owner-btn {
  border-left: 1rpx solid rgba(22, 40, 30, 0.08);
}

.owner-btn--danger {
  color: #d14343;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}

.submit-btn[disabled] {
  color: #ffffff;
  background: #b7c4bc;
}
