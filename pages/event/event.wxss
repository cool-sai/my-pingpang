.tab {
  font-size: 26rpx;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.event-item {
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(25, 45, 37, 0.06);
}

.event-cover {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #fff6d8 0%, #ffefba 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 184, 61, 0.18);
}

.event-icon {
  font-size: 60rpx;
}

.event-content {
  flex: 1;
}

.event-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  margin-bottom: 10rpx;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.event-time,
.event-location {
  font-size: 24rpx;
  color: #7a8796;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.event-status {
  flex-shrink: 0;
}

.event-signup {
  font-size: 24rpx;
  color: #7a8796;
}
