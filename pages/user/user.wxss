.container {
  padding: 0 0 32rpx;
}

.profile-section {
  position: relative;
  padding: 24rpx 24rpx 0;
  margin-bottom: 28rpx;
}

.profile-bg {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  height: 320rpx;
  background: linear-gradient(135deg, #167c49 0%, #32c26b 100%);
  border-radius: 32rpx;
  box-shadow: 0 24rpx 44rpx rgba(22, 124, 73, 0.22);
}

.profile-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 66rpx 32rpx 42rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 14rpx 28rpx rgba(19, 59, 37, 0.16);
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.score {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.login-tip {
  padding-top: 94rpx;
}

.login-btn {
  margin-top: 30rpx;
  background: #ffffff;
  color: #198f50;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 12rpx 24rpx rgba(18, 52, 35, 0.12);
}

.stats-section {
  display: flex;
  justify-content: space-around;
  margin: -34rpx 24rpx 24rpx;
  padding: 30rpx 0;
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(25, 45, 37, 0.07);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #198f50;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #7a8796;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #edf1ee;
  align-self: center;
}

.menu-section {
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 34rpx rgba(25, 45, 37, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #eef2ef;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
}

.menu-arrow {
  color: #c3cbd3;
  font-size: 28rpx;
}
