.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  box-sizing: border-box;
  pointer-events: none;
  background: transparent;
  border-bottom: 0;
  transition: background 0.2s ease, border-color 0.2s ease;
}

/* 非沉浸：实心顶栏，与下方内容分层（赛事资讯小程序常见做法） */
.nav:not(.nav--overlay) {
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.06);
  backdrop-filter: blur(16px);
}

.nav-inner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 100%;
  padding: 0 200rpx 0 28rpx;
  pointer-events: auto;
}

.nav-align--center .nav-inner {
  justify-content: center;
  padding-left: 200rpx;
}

.nav-align--left .nav-inner {
  justify-content: flex-start;
}

.nav-title-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  max-width: 100%;
}

.nav-title {
  max-width: 100%;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 720;
  line-height: 1.15;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-sub {
  margin-top: 2rpx;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
  opacity: 0.82;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav--dark .nav-title {
  color: #17211b;
}

.nav--dark .nav-sub {
  color: #6d7b8a;
}

/* 沉浸在头图上：几乎不挡内容，只靠字色和极轻顶影可读 */
.nav--light.nav--overlay:not(.nav--scrolled) {
  background: transparent;
}

.nav--light .nav-title {
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.nav--light .nav-sub {
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.nav--scrolled {
  background: rgba(242, 245, 243, 0.82);
  backdrop-filter: blur(18px);
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.04);
}

.nav--scrolled .nav-title {
  color: #17211b;
  text-shadow: none;
}

.nav--scrolled .nav-sub {
  color: #6d7b8a;
  text-shadow: none;
}

.nav-spacer {
  width: 100%;
  background: transparent;
}


/* 首页上滑：左上角城市 chip，可点开选城 */
.nav-city {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  min-height: 56rpx;
  padding: 0 8rpx 0 2rpx;
  box-sizing: border-box;
}

.nav-city--pressed {
  opacity: 0.68;
}

.nav-city-t {
  max-width: 280rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 720;
  line-height: 1.15;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-city-caret {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: -4rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  opacity: 0.55;
}

.nav--dark .nav-city-t,
.nav--dark .nav-city-caret {
  color: #17211b;
}

.nav--light:not(.nav--scrolled) .nav-city-t {
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.nav--light:not(.nav--scrolled) .nav-city-caret {
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.nav--scrolled .nav-city-t,
.nav--scrolled .nav-city-caret {
  color: #17211b;
  text-shadow: none;
}
