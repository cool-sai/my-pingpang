<wxs src="../../utils/skeleton.wxs" module="sk" />
<view class="container has-tab">
  <nav-bar title="排名" tone="light" overlay align="left" bind:layout="onNavLayout" />

  <!-- 我的排名 -->
  <view class="my-rank {{isLoading && !myRank ? 'is-skeleton' : ''}}" style="padding-top: {{navPad}}px;" bindtap="onViewMyRank">
    <text class="my-rank-label">我的排名</text>
    <view class="my-rank-info" wx:if="{{myRank}}">
      <text class="my-rank-num">第{{myRank.rank}}名</text>
      <text class="my-rank-score">{{myRank.score}}分</text>
    </view>
    <text class="my-rank-num" wx:elif="{{isLoading}}"></text>
    <text class="my-rank-num" wx:elif="{{!isLogin}}">登录查看</text>
    <text class="my-rank-num" wx:else>暂无成绩</text>
  </view>

  <!-- 筛选 -->
  <view class="filter-tabs">
    <view class="tab {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="switchFilter">全国</view>
    <view class="tab {{filter === 'club' ? 'active' : ''}}" data-filter="club" bindtap="switchFilter">俱乐部榜</view>
  </view>

  <!-- 排名列表 -->
  <view class="rank-list {{isLoading && rankings.length === 0 ? 'is-skeleton' : ''}}">
    <view class="rank-item {{item.rank <= 3 ? 'top' : ''}}" wx:for="{{sk.pad(rankings, isLoading, 5)}}" wx:key="_id" data-openid="{{item.openid}}" bindtap="goToUserDetail">
      <view class="rank-num {{item.rank <= 3 ? 'medal' : ''}}">
        <text wx:if="{{item.rank > 3}}">{{item._sk ? '' : item.rank}}</text>
        <text wx:if="{{item.rank === 1}}">🥇</text>
        <text wx:if="{{item.rank === 2}}">🥈</text>
        <text wx:if="{{item.rank === 3}}">🥉</text>
      </view>
      <image class="rank-avatar" src="{{item._sk ? '' : (item.avatar || 'data:image/svg+xml;base64,')}}" />
      <view class="rank-info">
        <text class="rank-name">{{item.nickname}}</text>
        <text class="rank-detail">{{item._sk ? '' : ('胜' + item.winMatches + ' 负' + item.loseMatches)}}</text>
      </view>
      <view class="rank-score-section">
        <text class="rank-score">{{item.score}}</text>
        <text class="rank-score-label">分</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{rankings.length === 0 && !isLoading}}">
      暂无排名数据
    </view>
  </view>
</view>

<page-loading wx:if="{{isLoading && rankings.length === 0}}" />
