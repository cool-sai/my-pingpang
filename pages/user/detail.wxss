.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.profile-avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  background: #e7eeea;
  border-radius: 50%;
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  overflow: hidden;
  color: #17211b;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-score-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 10rpx;
}

.profile-score {
  color: #148f4c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.profile-rank {
  color: #8b97a3;
  font-size: 24rpx;
  line-height: 1.2;
}

.profile-edit {
  flex-shrink: 0;
  width: auto;
  padding: 8rpx 0 8rpx 16rpx;
  color: #148f4c;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
}

.stats-section {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 28rpx 8rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 8rpx;
  min-width: 0;
}

.stat-value {
  color: #148f4c;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  color: #7a8796;
  font-size: 24rpx;
  line-height: 1.2;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: #e7eeea;
}

.chart-card {
  margin-top: 16rpx;
  padding: 28rpx 32rpx 16rpx;
  background: #ffffff;
}

.chart-title,
.list-title {
  display: block;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.chart-box {
  width: 100%;
  height: 360rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.chart-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.chart-card .empty-tip {
  padding: 48rpx 16rpx 32rpx;
}

.match-list {
  margin-top: 16rpx;
  background: #ffffff;
}

.list-title {
  padding: 28rpx 32rpx 8rpx;
}

.match-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.match-opponent {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #23303d;
  font-size: 30rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result-mark {
  flex-shrink: 0;
  width: 64rpx;
  color: #8b97a3;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.result-mark.is-win {
  color: #148f4c;
}

.result-mark.is-lose {
  color: #8b97a3;
}

.match-date {
  flex-shrink: 0;
  min-width: 160rpx;
  color: #617180;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: right;
}

.match-date.is-link {
  color: #148f4c;
}

.login-btn {
  width: auto;
  height: 72rpx;
  margin-top: 24rpx;
  padding: 0 48rpx;
  background: #148f4c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 36rpx;
}
