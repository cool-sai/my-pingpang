.club-hero {
  padding: 8rpx 32rpx 28rpx;
  background: linear-gradient(160deg, #0f6b3a 0%, #2fbe68 70%, #f2f5f3 120%);
}

.club-hero-title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 760;
  line-height: 1.25;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.18);
}

.club-hero-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
}

.club-list {
  display: flex;
  flex-direction: column;
}

.club-item {
  padding: 28rpx 32rpx;
  background: #ffffff;
  border: none;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
  border-radius: 0;
  box-shadow: none;
}

.club-header {
  display: flex;
  align-items: center;
  min-height: 84rpx;
}

.club-avatar {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

.club-info {
  flex: 1;
  min-width: 0;
}

.club-name {
  display: block;
  overflow: hidden;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.club-desc {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #7b8896;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.club-stats {
  display: flex;
  align-items: stretch;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2ef;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 6rpx;
  min-width: 0;
}

.stat-value {
  color: #148f4c;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-label {
  color: #7b8896;
  font-size: 22rpx;
  line-height: 1.2;
}
