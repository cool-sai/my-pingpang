<view class="container has-submit">
  <!-- 对手搜索 -->
  <view class="section">
    <text class="section-title">选择对手</text>
    <view class="search-box">
      <input class="search-input" placeholder="输入对手昵称搜索" placeholder-class="field-placeholder" value="{{searchKeyword}}" bindinput="setSearchKeyword" bindconfirm="searchOpponent" />
      <button class="search-btn" hover-class="none" bindtap="searchOpponent" loading="{{isSearching}}">搜索</button>
    </view>
    <view class="opponent-selected" wx:if="{{opponentName}}">
      <text>已选择: {{opponentName}}</text>
    </view>
  </view>

  <!-- 比分录入 -->
  <view class="section">
    <text class="section-title">比分</text>
    <view class="score-section">
      <view class="score-input">
        <text class="score-label">我方得分</text>
        <view class="score-control">
          <view class="score-btn score-btn--minus" bindtap="decrementScore" data-player="player1Score"></view>
          <text class="score-value">{{player1Score}}</text>
          <view class="score-btn score-btn--plus" bindtap="incrementScore" data-player="player1Score"></view>
        </view>
      </view>
      <view class="vs-wrap"><text class="vs-mark">:</text></view>
      <view class="score-input">
        <text class="score-label">对方得分</text>
        <view class="score-control">
          <view class="score-btn score-btn--minus" bindtap="decrementScore" data-player="player2Score"></view>
          <text class="score-value">{{player2Score}}</text>
          <view class="score-btn score-btn--plus" bindtap="incrementScore" data-player="player2Score"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 比赛信息 -->
  <view class="section">
    <text class="section-title">比赛信息</text>
    <input class="input-item" placeholder="比赛地点（选填）" placeholder-class="field-placeholder" bindinput="setLocation" value="{{location}}" />
  </view>
</view>

<view class="submit-bar">
  <button class="submit-btn" hover-class="none" bindtap="submitMatch" wx:if="{{opponentOpenid}}">提交比赛记录</button>
  <button class="submit-btn disabled" hover-class="none" wx:else>请先选择对手</button>
</view>
