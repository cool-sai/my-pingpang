/** app.wxss **/
page {
  min-height: 100%;
  background:
    radial-gradient(circle at top, #eef9f1 0%, #f6f8fb 30%, #f3f5f7 100%);
  color: #1f2937;
}

view,
text,
button,
input,
image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(25, 45, 37, 0.06);
}

.section:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18212f;
}

.section-more {
  padding: 6rpx 0;
  font-size: 24rpx;
  color: #5f6b7a;
}

.filter-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(31, 111, 66, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(25, 45, 37, 0.05);
}

.tab {
  flex: 1;
  min-width: 0;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.35;
  color: #627283;
}

.tab.active {
  background: linear-gradient(135deg, #1f9d57 0%, #32c26b 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(31, 157, 87, 0.2);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-pill--success {
  background: #e9f8ee;
  color: #198f50;
}

.status-pill--info {
  background: #eaf3ff;
  color: #2c6de0;
}

.status-pill--warning {
  background: #fff4e8;
  color: #ea8a22;
}

.status-pill--muted {
  background: #eef1f4;
  color: #778391;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 88rpx 32rpx;
  text-align: center;
  color: #718192;
  font-size: 28rpx;
}

.empty-subtip {
  font-size: 24rpx;
  color: #97a3af;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 188rpx;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #16924f 0%, #32c26b 100%);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 600;
  box-shadow: 0 20rpx 36rpx rgba(22, 146, 79, 0.24);
}
