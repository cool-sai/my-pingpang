.section-title {
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.25;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input,
.input-item {
  display: block;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #f5f8f6;
  border: 1rpx solid #e6eeea;
  border-radius: 18rpx;
  color: #1c2430;
  font-size: 28rpx;
  line-height: 84rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
}

.search-btn {
  flex-shrink: 0;
  width: 148rpx;
  height: 84rpx;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 18rpx;
}

.opponent-selected {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #edf9f1;
  border-radius: 18rpx;
  color: #148f4c;
  font-size: 28rpx;
  line-height: 1.3;
}

.score-section {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.score-input {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 24rpx 12rpx 28rpx;
  background: #f7faf8;
  border-radius: 22rpx;
}

.score-label {
  display: block;
  margin-bottom: 20rpx;
  color: #647384;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.score-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.score-btn {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border: 1rpx solid #dfe7e2;
  border-radius: 50%;
}

.score-btn::before,
.score-btn--plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: #23303d;
  border-radius: 2rpx;
}

.score-btn::before {
  width: 24rpx;
  height: 4rpx;
  margin-left: -12rpx;
  margin-top: -2rpx;
}

.score-btn--plus::after {
  width: 4rpx;
  height: 24rpx;
  margin-left: -2rpx;
  margin-top: -12rpx;
}

.score-value {
  min-width: 64rpx;
  color: #148f4c;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.vs-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  width: 32rpx;
  padding-bottom: 28rpx;
}

.vs-mark {
  height: 64rpx;
  color: #9aa7b4;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 46rpx;
  box-shadow: 0 12rpx 24rpx rgba(20, 143, 76, 0.2);
}

.submit-btn.disabled {
  background: #d5dbe1;
  color: #ffffff;
  box-shadow: none;
}
