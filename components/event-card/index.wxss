.card {
  position: relative;
  padding: 28rpx 32rpx 24rpx 40rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 6rpx;
  background: #148f4c;
}

.card--upcoming::before {
  background: #2c6de0;
}

.card--finished::before {
  background: #d5dde3;
}

.card--pressed {
  background: #f3f7f4;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #148f4c;
}

.card-status--upcoming {
  color: #2c6de0;
}

.card-status--finished {
  color: #8b97a3;
}

.card-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.card-k {
  flex-shrink: 0;
  width: 64rpx;
  color: #8b97a3;
  font-size: 26rpx;
  line-height: 1.4;
}

.card-v {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #243028;
  font-size: 26rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.card-who,
.card-count {
  overflow: hidden;
  color: #6d7b8a;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-who {
  flex: 1;
  min-width: 0;
}

.card-count {
  flex-shrink: 0;
}
