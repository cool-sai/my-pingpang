.cover {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #e8efe9;
}

.hero,
.sheet,
.block {
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.hero {
  padding: 32rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  height: 40rpx;
  padding: 0 14rpx;
  color: #148f4c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  background: rgba(20, 143, 76, 0.1);
  border-radius: 8rpx;
}

.tag--upcoming {
  color: #2c6de0;
  background: rgba(44, 109, 224, 0.1);
}

.tag--finished {
  color: #8b97a3;
  background: #eef2f4;
}

.tag--format {
  color: #148f4c;
  background: rgba(20, 143, 76, 0.1);
}

.hero-title {
  flex: 1;
  min-width: 0;
  color: #17211b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

/* 标题行右侧「分享」小胶囊按钮 */
.share-btn-title {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: auto;
  height: 52rpx;
  padding: 0 20rpx;
  margin: 4rpx 0 0;
  color: #148f4c;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(20, 143, 76, 0.08);
  border-radius: 26rpx;
}

.share-btn-title::after {
  border: none;
}

.share-btn-title--hover {
  background: rgba(20, 143, 76, 0.18);
}

.share-btn-text {
  line-height: 1;
}

/* 纯 CSS 分享小图标：三圆点 + 连线 */
.share-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.share-dot {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  background: #148f4c;
  border-radius: 50%;
}

.share-dot--c {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}

.share-dot--t {
  right: 0;
  top: 0;
}

.share-dot--b {
  right: 0;
  bottom: 0;
}

.share-line {
  position: absolute;
  left: 7rpx;
  width: 15rpx;
  height: 2rpx;
  background: #148f4c;
  transform-origin: left center;
}

.share-line--t {
  top: 4rpx;
  transform: rotate(-28deg);
}

.share-line--b {
  bottom: 4rpx;
  transform: rotate(28deg);
}

.line {
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 88rpx;
  padding: 0 32rpx;
}

.line + .line {
  border-top: 1rpx solid rgba(22, 40, 30, 0.08);
}

.line-k {
  flex-shrink: 0;
  width: 72rpx;
  color: #8b97a3;
  font-size: 28rpx;
}

.line-v {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.line-v--link {
  color: #148f4c;
}

.roster-link {
  flex-shrink: 0;
  color: #148f4c;
  font-size: 26rpx;
  line-height: 1.2;
}

.block {
  padding: 28rpx 32rpx 32rpx;
}

.block-k {
  display: block;
  color: #8b97a3;
  font-size: 26rpx;
  line-height: 1.4;
}

.block-v {
  display: block;
  margin-top: 12rpx;
  color: #243028;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.manage-text {
  flex-shrink: 0;
  padding: 12rpx 4rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 1.2;
}

.submit-btn {
  flex: 1;
  height: 88rpx;
  margin: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 88rpx;
  background: #148f4c;
  border-radius: 12rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn--ghost {
  color: #148f4c;
  background: #ffffff;
}

.submit-btn[disabled] {
  color: #ffffff;
  background: #b7c4bc;
}

.manage-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(23, 33, 27, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.manage-mask--on {
  opacity: 1;
  pointer-events: auto;
}

.manage-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.22s ease;
}

.manage-sheet--on {
  transform: translateY(0);
}

.manage-action {
  height: 104rpx;
  color: #17211b;
  font-size: 32rpx;
  line-height: 104rpx;
  text-align: center;
  background: #ffffff;
}

.manage-action + .manage-action {
  border-top: 1rpx solid rgba(22, 40, 30, 0.08);
}

.manage-action--danger {
  color: #d14343;
}

.manage-gap {
  height: 16rpx;
  background: #f2f5f3;
}
