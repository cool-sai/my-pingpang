<view class="home">
  <swiper
    class="banner"
    indicator-dots
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#ffffff"
    autoplay="{{news.length > 1}}"
    circular="{{news.length > 1}}"
    interval="4000"
    duration="500"
  >
    <swiper-item wx:for="{{news}}" wx:key="id">
      <view class="banner-slide" data-id="{{item.id}}" bindtap="goToNews">
        <image wx:if="{{item.cover}}" class="banner-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="banner-mask">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-summary">{{item.summary}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="list-head">
    <text class="list-title">比赛</text>
    <text class="list-more" bindtap="goToEvent">更多</text>
  </view>

  <view
    class="event-item"
    wx:for="{{events}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="goToEventDetail"
  >
    <view class="event-main">
      <text class="event-name">{{item.name}}</text>
      <text class="event-meta">{{item.startTime || '时间待定'}}  {{item.location || '地点待定'}}</text>
      <text class="event-meta">{{item.signupCount || 0}} 人报名</text>
    </view>
    <text class="event-status">{{item.statusText}}</text>
  </view>
  <view class="empty-tip" wx:if="{{events.length === 0}}">附近还没有比赛</view>
</view>
