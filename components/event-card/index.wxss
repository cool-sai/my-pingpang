.card {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  margin: 0 28rpx 22rpx;
  padding: 22rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow:
    0 14rpx 40rpx rgba(18, 40, 28, 0.07),
    0 1rpx 0 rgba(255, 255, 255, 0.9) inset;
}

.card--pressed {
  background: #f7faf8;
}

.card-cover-wrap {
  flex-shrink: 0;
  width: 176rpx;
  height: 228rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #e8efe9;
  box-shadow: 0 8rpx 20rpx rgba(18, 40, 28, 0.08);
}

.card-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.card-cover--empty {
  background: linear-gradient(160deg, #eef5f0 0%, #d9e7de 100%);
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 2rpx 0;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.card-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.card-tag {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 14rpx;
  color: #148f4c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  background: rgba(20, 143, 76, 0.1);
  border-radius: 999rpx;
}

.card-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.card-k {
  flex-shrink: 0;
  width: 56rpx;
  color: #8b97a3;
  font-size: 24rpx;
  line-height: 1.45;
}

.card-v {
  flex: 1;
  min-width: 0;
  color: #243028;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.card-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.card-chip {
  height: 36rpx;
  padding: 0 14rpx;
  color: #2c6de0;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 36rpx;
  background: rgba(44, 109, 224, 0.08);
  border-radius: 8rpx;
}

.card-chip--muted {
  color: #6d7b8a;
  background: #eef2f4;
}

.card.is-skeleton .card-cover,
.card.is-skeleton .card-cover--empty {
  background: rgba(22, 40, 30, 0.07);
  background-image: none;
  box-shadow: none;
}

.card.is-skeleton .card-name,
.card.is-skeleton .card-tag,
.card.is-skeleton .card-v {
  color: transparent !important;
  background-color: rgba(22, 40, 30, 0.07);
  border-radius: 8rpx;
  min-height: 1em;
}

.card.is-skeleton .card-name {
  width: 70%;
  min-height: 40rpx;
}

.card.is-skeleton .card-tag {
  width: 88rpx;
  min-width: 88rpx;
  height: 40rpx;
}

.card.is-skeleton .card-v {
  width: 64%;
  min-height: 28rpx;
}

.card.is-skeleton .card-k {
  visibility: hidden;
}
