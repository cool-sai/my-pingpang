<wxs src="../../utils/skeleton.wxs" module="sk" />
<page-loading wx:if="{{isLoading}}" />
<view class="container {{isLoading && !signups.length ? 'is-skeleton' : ''}}">
  <view class="person" wx:for="{{sk.pad(signups, isLoading, 5)}}" wx:key="openid">
    <image class="person-avatar" mode="aspectFill" src="{{item.avatar}}" data-openid="{{item.openid}}" binderror="onAvatarError" />
    <text class="person-name">{{item.nickname}}</text>
  </view>
  <view class="empty-tip" wx:if="{{!isLoading && missing}}">没有找到这场比赛</view>
  <view class="empty-tip" wx:elif="{{!isLoading && signups.length === 0}}">还没有人报名</view>
</view>
