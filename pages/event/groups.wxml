<view wx:if="{{!isLoading}}">
  <view class="row" wx:for="{{groups}}" wx:key="groupNo" data-group-no="{{item.groupNo}}" bindtap="openGroup">
    <view class="row-main">
      <text class="row-title">{{item.title}}</text>
      <text class="row-meta">{{item.count}}人 · 已赛 {{item.played}}/{{item.total}}</text>
      <text wx:if="{{item.note}}" class="row-note">{{item.note}}</text>
    </view>
    <text class="row-go">对战</text>
    <text wx:if="{{isOwner}}" class="row-edit" data-group-no="{{item.groupNo}}" catchtap="editNote">备注</text>
  </view>
  <view class="empty-tip" wx:if="{{groups.length === 0}}">还没有分组</view>
</view>
