.hero,
.sheet,
.quota,
.block,
.owner-bar {
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.hero {
  padding: 36rpx 32rpx 32rpx;
}

.tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag {
  height: 40rpx;
  padding: 0 14rpx;
  color: #148f4c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  background: rgba(20, 143, 76, 0.1);
  border-radius: 8rpx;
}

.tag--upcoming {
  color: #2c6de0;
  background: rgba(44, 109, 224, 0.1);
}

.tag--finished {
  color: #8b97a3;
  background: #eef2f4;
}

.tag--format {
  color: #148f4c;
  background: rgba(20, 143, 76, 0.1);
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  color: #17211b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-who {
  display: block;
  margin-top: 12rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 1.4;
}

.line {
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 88rpx;
  padding: 0 32rpx;
}

.line + .line {
  border-top: 1rpx solid rgba(22, 40, 30, 0.08);
}

.line-k {
  flex-shrink: 0;
  width: 72rpx;
  color: #8b97a3;
  font-size: 28rpx;
}

.line-v {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.line-v--link {
  color: #148f4c;
}

.quota {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 36rpx 32rpx;
}

.quota-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}

.quota-num {
  color: #17211b;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.quota-num--max {
  color: #526070;
}

.quota-sep {
  color: #c5ced6;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.quota-label {
  margin-top: 8rpx;
  color: #8b97a3;
  font-size: 24rpx;
  line-height: 1.3;
}

.block {
  padding: 28rpx 32rpx 32rpx;
}

.block-k {
  display: block;
  color: #8b97a3;
  font-size: 26rpx;
  line-height: 1.4;
}

.block-v {
  display: block;
  margin-top: 12rpx;
  color: #243028;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.block-empty {
  display: block;
  margin-top: 16rpx;
  color: #8b97a3;
  font-size: 26rpx;
}

.person {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.person-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  background: #e7eeea;
  border-radius: 50%;
}

.person-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.owner-bar {
  display: flex;
}

.owner-btn {
  flex: 1;
  height: 96rpx;
  color: #148f4c;
  font-size: 30rpx;
  font-weight: 600;
}

.owner-btn + .owner-btn {
  border-left: 1rpx solid rgba(22, 40, 30, 0.08);
}

.owner-btn--danger {
  color: #d14343;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}

.submit-btn[disabled] {
  color: #ffffff;
  background: #b7c4bc;
}
