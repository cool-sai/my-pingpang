.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 148rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #127a42 0%, #2fbe68 100%);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 122, 66, 0.22);
}

.user-section {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 50%;
}

.nickname {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.score-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 128rpx;
  min-height: 92rpx;
  padding: 10rpx 18rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
}

.score-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1.2;
}

.score-value {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.quick-actions {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 160rpx;
  padding: 28rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(22, 40, 30, 0.06);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 32, 0.05);
}

.action-btn.primary {
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(20, 143, 76, 0.22);
}

.action-icon {
  height: 52rpx;
  font-size: 44rpx;
  line-height: 52rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.action-btn.primary .action-text {
  color: #ffffff;
}

.action-btn.secondary .action-text {
  color: #25313f;
}

.event-list,
.rank-list,
.club-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.event-item,
.club-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 108rpx;
  padding: 20rpx;
  background: #f7faf8;
  border-radius: 18rpx;
}

.event-info,
.club-info,
.rank-info {
  flex: 1;
  min-width: 0;
}

.event-name,
.club-name,
.rank-name {
  display: block;
  overflow: hidden;
  color: #25313f;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-time,
.club-members,
.rank-score {
  display: block;
  margin-top: 6rpx;
  color: #728294;
  font-size: 24rpx;
  line-height: 1.3;
}

.event-status,
.club-score {
  flex-shrink: 0;
}

.club-score {
  color: #148f4c;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

.rank-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx;
  background: #f7faf8;
  border-radius: 18rpx;
}

.rank-num {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  color: #6d7b8a;
  font-size: 24rpx;
  line-height: 1;
}

.rank-num.top {
  background: linear-gradient(135deg, #ffcb45 0%, #ff9b2f 100%);
  color: #ffffff;
  border-radius: 50%;
  font-weight: 700;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 50%;
}
