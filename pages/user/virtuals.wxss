.virtual-list {
  background: #ffffff;
}

.virtual-item {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.player-avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  background: #e7eeea;
  border-radius: 50%;
}

.person-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.delete-btn {
  flex-shrink: 0;
  width: auto;
  margin-left: 16rpx;
  padding: 8rpx 8rpx 8rpx 16rpx;
  color: #d14343;
  font-size: 26rpx;
  line-height: 1.3;
}

.menu-arrow {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-top: 4rpx solid #c5ced6;
  border-right: 4rpx solid #c5ced6;
  transform: rotate(45deg);
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}
