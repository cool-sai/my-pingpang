.tabs {
  height: 88rpx;
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
  background: #ffffff;
  box-sizing: border-box;
}

.tab {
  display: inline-block;
  margin-right: 16rpx;
  padding: 8rpx 20rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  background: #f2f5f3;
  border-radius: 999rpx;
}

.tab--on {
  color: #148f4c;
  font-weight: 700;
  background: rgba(20, 143, 76, 0.12);
}

.note {
  padding: 16rpx 32rpx 0;
  color: #6d7b8a;
  font-size: 26rpx;
  background: #ffffff;
}

.table {
  margin-top: 16rpx;
  background: #ffffff;
}

.table-row {
  display: flex;
}

.cell {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
  border-right: 1rpx solid rgba(22, 40, 30, 0.06);
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.cell--name {
  flex: none;
  width: 168rpx;
  padding: 0 12rpx;
  overflow: hidden;
  color: #17211b;
  font-size: 24rpx;
  text-align: left;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cell--win {
  color: #d14343;
  font-size: 32rpx;
  font-weight: 700;
}

.cell--lose {
  color: #8b97a3;
  font-size: 32rpx;
  font-weight: 700;
}
