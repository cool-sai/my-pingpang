<wxs src="../../utils/skeleton.wxs" module="sk" />
<page-loading wx:if="{{isLoading}}" />
<view class="container {{isLoading && !opponents.length ? 'is-skeleton' : ''}}">
  <view class="tip" wx:if="{{isLoading || opponents.length}}">点获胜的人</view>
  <view class="head" wx:if="{{isLoading || title}}">
    <text class="head-title">{{title}}</text>
    <text wx:if="{{note}}" class="head-note">{{note}}</text>
  </view>
  <view class="match" wx:for="{{sk.pad(opponents, isLoading, 3)}}" wx:key="openid">
    <text
      class="pick {{item.left.win ? 'pick--win' : ''}}"
      data-openid="{{item.openid}}"
      data-winner="{{item.left.openid}}"
      data-name="{{item.left.label}}"
      data-done="{{item.done}}"
      bindtap="onPick"
    >{{item.left.label}}</text>
    <text class="vs">对</text>
    <text
      class="pick {{item.right.win ? 'pick--win' : ''}}"
      data-openid="{{item.openid}}"
      data-winner="{{item.right.openid}}"
      data-name="{{item.right.label}}"
      data-done="{{item.done}}"
      bindtap="onPick"
    >{{item.right.label}}</text>
  </view>
  <view class="empty-tip" wx:if="{{!isLoading && opponents.length === 0}}">{{emptyText}}</view>
</view>
