.field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.field--block {
  display: block;
  padding: 28rpx 32rpx 32rpx;
}

.field--place {
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.field--place .field-label {
  padding-top: 4rpx;
}

.field-place {
  position: relative;
  flex: 1;
  min-width: 0;
  padding-right: 28rpx;
}

.field-place::after {
  content: '';
  position: absolute;
  right: 4rpx;
  top: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #b0b8c0;
  border-bottom: 3rpx solid #b0b8c0;
  transform: rotate(45deg);
}

.field-place-name {
  display: block;
  color: #17211b;
  font-size: 30rpx;
  line-height: 1.4;
}

.field-place.is-placeholder .field-place-name {
  color: #a3adb8;
}

.field-place-addr {
  display: block;
  margin-top: 6rpx;
  padding-right: 8rpx;
  color: #6d7b8a;
  font-size: 24rpx;
  line-height: 1.4;
}

.field-label {
  flex-shrink: 0;
  width: 112rpx;
  color: #526070;
  font-size: 28rpx;
  line-height: 1.4;
}

.field-input,
.field-picker {
  flex: 1;
  min-width: 0;
}

.count-step {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.count-step-btn {
  width: 64rpx;
  height: 64rpx;
  color: #148f4c;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
}

.count-step-input {
  width: 88rpx;
  height: 64rpx;
  color: #17211b;
  font-size: 32rpx;
  line-height: 64rpx;
  text-align: center;
}

.field-picker {
  display: block;
}

.field-input,
.field-value {
  height: 104rpx;
  color: #17211b;
  font-size: 30rpx;
  line-height: 104rpx;
}

.field-value--pick {
  position: relative;
  padding-right: 28rpx;
}

.field-value--pick::after {
  content: '';
  position: absolute;
  right: 4rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-top: -12rpx;
  border-right: 3rpx solid #b0b8c0;
  border-bottom: 3rpx solid #b0b8c0;
  transform: rotate(45deg);
}

.is-placeholder {
  color: #a3adb8;
}

.field-area {
  width: 100%;
  height: 200rpx;
  margin-top: 16rpx;
  color: #17211b;
  font-size: 30rpx;
  line-height: 1.5;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #148f4c 0%, #2fbe68 100%);
  border-radius: 0;
}

.submit-btn[disabled] {
  color: #ffffff;
  background: #b7c4bc;
}

.field--cover {
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.field--cover .field-label {
  padding-top: 8rpx;
}

.cover-box {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 220rpx;
  overflow: hidden;
  background: #f3f7f4;
  border-radius: 16rpx;
}

.cover-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 8rpx;
}

.cover-empty-title {
  color: #148f4c;
  font-size: 28rpx;
  font-weight: 700;
}

.cover-empty-sub {
  color: #8b97a3;
  font-size: 22rpx;
}

.cover-clear {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  height: 48rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 48rpx;
  background: rgba(23, 33, 27, 0.55);
  border-radius: 999rpx;
}
