.home {
  padding-bottom: calc(28rpx + 48px + env(safe-area-inset-bottom));
}

.banner {
  height: 360rpx;
}

.banner-slide {
  position: relative;
  height: 360rpx;
  background: #127a42;
}

.banner-cover {
  width: 100%;
  height: 360rpx;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(180deg, rgba(12, 28, 20, 0) 0%, rgba(12, 28, 20, 0.72) 100%);
}

.banner-title {
  display: block;
  overflow: hidden;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.banner-summary {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(22, 40, 30, 0.08);
}

.region-side {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-width: 0;
  flex: 1;
}

.region-pick {
  overflow: hidden;
  max-width: 460rpx;
  height: 88rpx;
  color: #148f4c;
  font-size: 28rpx;
  line-height: 88rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.region-clear {
  flex-shrink: 0;
  color: #6d7b8a;
  font-size: 26rpx;
  line-height: 88rpx;
}

.list-action {
  flex-shrink: 0;
  margin-left: 24rpx;
  color: #148f4c;
  font-size: 26rpx;
  line-height: 88rpx;
}

.list-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 32rpx 12rpx;
}

.list-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(20, 143, 76, 0.18);
  border-top-color: #148f4c;
  border-radius: 50%;
  animation: list-spin 0.8s linear infinite;
}

@keyframes list-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
