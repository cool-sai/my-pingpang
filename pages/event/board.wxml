<view class="{{signed ? 'has-score' : ''}}" wx:if="{{!isLoading}}">
  <scroll-view class="tabs" scroll-x wx:if="{{tabs.length > 1 || signed}}">
    <view
      class="tab {{item.groupNo === groupNo ? 'tab--on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="groupNo"
      data-group-no="{{item.groupNo}}"
      bindtap="onTab"
    >
      <text>{{item.title}}</text>
      <view wx:if="{{item.mine}}" class="tab-dot"></view>
    </view>
  </scroll-view>
  <view class="note-row" wx:if="{{note || isOwner}}">
    <text class="note">{{note || '暂无备注'}}</text>
    <text wx:if="{{isOwner}}" class="note-edit" bindtap="editNote">备注</text>
  </view>
  <view class="table" wx:if="{{rows.length}}">
    <view class="table-row table-row--head">
      <view class="cell cell--name"></view>
      <view class="cell" wx:for="{{heads}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="table-row" wx:for="{{rows}}" wx:key="no" wx:for-item="row">
      <view class="cell cell--name {{row.mine ? 'cell--mine' : ''}}">{{row.label}}</view>
      <view
        class="cell {{cell.self ? 'cell--self' : ''}} {{cell.mark === 'win' ? 'cell--win' : ''}} {{cell.mark === 'lose' ? 'cell--lose' : ''}}"
        wx:for="{{row.cells}}"
        wx:for-item="cell"
        wx:key="key"
        data-left="{{cell.left}}"
        data-right="{{cell.right}}"
        data-left-name="{{cell.leftName}}"
        data-right-name="{{cell.rightName}}"
        data-mark="{{cell.mark}}"
        bindtap="onCell"
      >{{cell.mark === 'win' ? '✓' : cell.mark === 'lose' ? '×' : ''}}</view>
    </view>
  </view>
  <view class="empty-tip" wx:if="{{rows.length === 0}}">这一组没有人</view>
</view>
<view class="submit-bar" wx:if="{{!isLoading && signed}}">
  <button class="submit-btn" hover-class="none" bindtap="goToScore">录入成绩</button>
</view>
